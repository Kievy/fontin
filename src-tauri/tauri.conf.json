{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fontin",
  "version": "0.1.3",
  "identifier": "app.fontin.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Fontin",
        "width": 1360,
        "height": 864,
        "minWidth": 1024,
        "minHeight": 640,
        "backgroundColor": "#08090b",
        "center": true,
        "visible": false,
        "label": "main",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Gerenciador de fontes: ative sem instalar.",
    "category": "Utility",
    "createUpdaterArtifacts": true,
    "publisher": "Kievy",
    "homepage": "https://github.com/Kievy/fontin",
    "copyright": "MIT",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "fontconfig"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCMTAyNEU2RDZDM0Y1NzUKUldSMTljUFc1aVFRaTlsWHRYN1E1S3kvbkZhNE9iRHhwS1BJZUFoQmRYYmlhTmJ0dS84aW1yK0IK",
      "endpoints": [
        "https://github.com/Kievy/fontin/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
