{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fontin",
  "version": "0.1.0",
  "identifier": "app.fontin.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Fontin",
        "width": 1360,
        "height": 864,
        "minWidth": 1024,
        "minHeight": 640,
        "backgroundColor": "#08090b",
        "center": true,
        "visible": false,
        "label": "main",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Gerenciador de fontes: ative sem instalar.",
    "category": "Utility"
  }
}
